import java.util.Scanner;
public class Main{
  public static void main(String[] args){
    Scanner s = new Scanner(System.in);
    if(!s.hasNextInt()){
      return;
    }
    int a = s.nextInt();
    int b = s.nextInt();
    
  if((a>0 && b>0) || (a<0 && b<0)){
    System.out.println("Yes");
  }else{
    System.out.println("No");
  }
  s.close();
  }
}
