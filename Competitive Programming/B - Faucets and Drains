import java.util.Scanner;
public class Main{
  public static void main(String[] args){
    Scanner s = new Scanner(System.in);
    if(!s.hasNextInt()){
      return;
    }
    int n = s.nextInt();
    int m = s.nextInt();
    
    String[] g = new String[n];
    for(int i=0;i<n;i++){
      g[i] = s.next();
    }
    
    for(int i =0;i<n;i++){
      if(g[i].indexOf('o') == -1){
        System.out.println("Faucet " + (i+1));
        s.close();
        return;
      }
    }
    for(int j=0;j<m;j++){
      boolean ok = false;
      for(int i=0;i<n;i++){
        if(g[i].charAt(j)=='o'){
          ok = true;
          break;
        }
      }
      if(!ok){
        System.out.println("Drain " + (j + 1));
        s.close();
        return;
      }
    }
    s.close();
  }
}
