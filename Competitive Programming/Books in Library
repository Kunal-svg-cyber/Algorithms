#include <bits/stdc++.h>
using namespace std;

bool ok(vector<long long>& v, int k, long long m){
    int c=1;
    long long s=0;
    for(int i=0;i<(int)v.size();i++){
        if(s+v[i] <= m){
            s += v[i];
        }else{
            c++;
            s=v[i];
            if(c>k) return false;
        }
    }
    return true;
}
int main() {
	ios_base::sync_with_stdio(false);
	cin.tie(NULL);
	int t;
	cin>>t;
	while(t--){
	    int n, a;
	    cin >> n>>a;
	    vector<long long> v(n);
	    long long l=0,r=0;
	    for(int i=0;i<n;i++){
	        cin>> v[i];
	        if(v[i] > l) l = v[i];
	        r += v[i];
	    }
	    long long ans = r;
	    while(l<=r){
	        long long m = l + (r-l) / 2;
	        if(ok(v,a,m)){
	            ans = m;
	            r=m - 1;
	        }else{
	            l=m + 1;
	        }
	    }
	    cout<<ans<<"\n";
	}
	return 0;

}
