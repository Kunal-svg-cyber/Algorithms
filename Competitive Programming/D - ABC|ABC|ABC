#include <iostream>
#include <string>
using namespace std;

int main(){
  ios::sync_with_stdio(false);
  cin.tie(nullptr);
  
  int n;
  string s;
  if(!(cin >> n >> s)) return 0;
  
  int sc[3] = {0}, sd =0,mj=-1;
  for(int j = n-1;j>=1;j--){
    int x = s[j] - 'A';
    if(sc[x] == 0) sd++;
    sc[x]++;
    if(sd == 3){
      mj = j;
      break;
    }
  }
  if(mj == -1){
    cout << 0 << '\n';
    return 0;
  }
  
  int pc[3] = {0},pd=0;
  int mc[3] = {0},md =0;
  int r =0;
  long long ans =0;
  
  for(int i = 1;i<= n-2;i++){
    int p = s[i-1] - 'A';
    if(pc[p] == 0) pd++;
    pc[p]++;
    
    if(r<i){
      r=i;
    }else if(i>1){
      mc[p]--;
      if(mc[p] ==0) md--;
    }
    
    while(r<n && md < 3){
      int c = s[r] - 'A';
      if(mc[c] == 0) md++;
      mc[c]++;
      r++;
    }
    
    if(md < 3) break;
    if(pd==3 && r <= mj){
      ans += mj - r + 1;
    }
  }
  cout << ans<<'\n';
  return 0;
}
