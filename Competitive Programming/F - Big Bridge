#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main(){
  ios::sync_with_stdio(false);
  cin.tie(nullptr);
  
  int n, m;
  if(!(cin >> n >> m)) return 0;
  
  vector<int> c(n);
  vector<long long> v(n);
  for(int i=0;i<n;i++){
    cin >> c[i] >> v[i];
  }
  for(int j =0;j<=m;j++){
    vector<long long> d(m + 1, 0);
    long long f_v=0;
    
    for(int i=0;i<n;i++){
      int p = max(0, c[i] - j);
      if(p==0){
        f_v += v[i];
        continue;
      }
      for(int k=m;k >= p;k--){
        d[k] = max(d[k], d[k-p] + v[i]);
      }
    }
    cout<<(f_v + d[m])<<'\n';
  }
  return 0;
}
