#include <bits/stdc++.h>
using namespace std;

int tmr,ans;
vector<int> adj[1005];
int d[1005], l[1005];

void dfs(int u,int p){
    d[u] = l[u] = ++tmr;
    for(int i=0;i<(int)adj[u].size();i++){
        int v=adj[u][i];
        if(v==p) continue;
        if(d[v]){
            if(d[v] < l[u]) l[u] = d[v];
        }else{
            dfs(v,u);
            if(l[v] < l[u]) l[u] = l[v];
            if(l[v] > d[u]) ans++;
        }
    }
}
int main() {
	ios_base::sync_with_stdio(false);
	cin.tie(NULL);
	int t;
	cin>>t;
	while(t--){
	    int n,m;
	    cin>>n>>m;
	    for(int i=1;i<=n;i++){
	        adj[i].clear();
	        d[i]=0;
	        l[i]=0;
	    }
	    for(int i=0;i<m;i++){
	        int a,b;
	        cin>>a>>b;
	        adj[a].push_back(b);
	        adj[b].push_back(a);
	    }
	    tmr=0;
	    ans=0;
	    for(int i=1;i<=n;i++){
	        if(!d[i]) dfs(i, -1);
	    }
	    cout<< ans<<"\n";
	}
	return 0;

}
