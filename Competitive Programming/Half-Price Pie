import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc = new Scanner(System.in);
		if(!sc.hasNextInt()) return;
		int t = sc.nextInt();
		while(t-- > 0){
		    int n = sc.nextInt();
		    int[] a = new int[n];
		    long s=0;
		    
		    for(int i=0;i<n;i++){
		        a[i] = sc.nextInt();
		        s += a[i];
		    }
		    
		    long m = a[0] + a[1];
		    for(int i=1;i<n-1;i++){
		        long p = a[i] + a[i+1];
		        if(p<m){
		            m=p;
		        }
		    }
		    System.out.println(s- (m/2));
		}
		sc.close();

	}
}
