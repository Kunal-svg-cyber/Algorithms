class Solution {
    public long countValidSubstrings(String s) {
        long ans =0;
        int ms = -1;

        for(int i =0; i< s.length(); i++){
            if(i >= 2 && s.charAt(i) == 'c' && s.charAt(i-1) == 'b' && s.charAt(i-2) == 'a'){
                ms = i-2;
            }
            ans += (i - ms);
        }
        return ans;
    }
}
