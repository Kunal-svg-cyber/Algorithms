class Solution {
    public int countDominantElements(int[] nums) {
        int n = nums.length;
        if(n==1) return 1;

        int c = 0;
        for(int i=0;i<n;i++){
            long x = nums[i];
            if(i==0){
                if(x>=nums[1]) c++;
            }else if (i==n-1){
                if(x>=nums[n-2]) c++;
            }else{
                long s = (long) nums[i-1] + nums[i+1];
                if(2L * x >= s) c++;
            }
        }
        return c;
    }
}
